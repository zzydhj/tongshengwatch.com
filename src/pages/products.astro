---
// products.astro - Products & Services (English)
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Product data from content collection (for detail page links & images)
const collectionProducts = (await getCollection("products")).sort(
    (a, b) => a.data.order - b.data.order,
);

// English product display data
const productInfo: Record<
    string,
    {
        title: string;
        feature: string;
        desc: string;
        materials: string;
        capacity: string;
    }
> = {
    solid: {
        title: "Solid Band",
        feature: "Corrosion-Resistant · Rust & Sweat Proof",
        desc: "Molybdenum-enriched alloy resists sweat, seawater and cosmetics — won't oxidize or tarnish during daily wear. Ideal for sports, outdoor and coastal environments. Crafted from top-grade materials to precisely match diverse brand positioning.",
        materials:
            "316L SS / 304 SS / 6063 Aluminum / Ti Grade 2 / Ti Grade 5 / Tantalum",
        capacity: "80,000 pieces / month",
    },
    edge: {
        title: "Edge-Wrapped Band",
        feature: "Premium Finish · Versatile Style",
        desc: "Sophisticated texture with brushed, mirror, sandblasted and PVD plating options (gold, gunmetal, two-tone, rose gold) — covering business-casual to luxury segments.",
        materials: "316L Stainless Steel / 304 Stainless Steel",
        capacity: "100,000 pieces / month",
    },
    case: {
        title: "Watch Case",
        feature: "Multi-Material · Precision CNC",
        desc: "Supports 6063 aluminum, ceramic, 304/316L stainless steel, titanium Grade 2/5 and tantalum. Serves both large brand orders and small-batch custom requests with 5-axis CNC capability.",
        materials:
            "6063 Aluminum / Ceramic / 304 & 316L SS / Ti Gr.2 / Ti Gr.5 / Tantalum",
        capacity: "40,000 sets / month",
    },
    mesh: {
        title: "Mesh Band",
        feature: "Fast Response · Reliable Lead Time",
        desc: "Rapid turnaround with initial quotes and proposals within 24 hours of inquiry. PMC team tracks every production stage to ensure transparent progress and on-time delivery.",
        materials: "316L Stainless Steel / 304 Stainless Steel",
        capacity: "30,000 pieces / month",
    },
    spring: {
        title: "Spring Band",
        feature: "End-to-End Customization",
        desc: "Full-chain one-stop service from concept to finished product. Custom molds from client samples; extensive design library for quick selection and rapid turnaround.",
        materials: "316L Stainless Steel / 304 Stainless Steel",
        capacity: "Flexible capacity for custom orders",
    },
};

const promises = [
    {
        icon: "⏱️",
        title: "On-Time Delivery",
        desc: "Clear production planning with PMC tracking; regular progress updates and transparent scheduling.",
    },
    {
        icon: "✅",
        title: "Quality Assured",
        desc: "ISO 9001 certified; equipped with water-pressure, salt-spray and artificial sweat testers.",
    },
    {
        icon: "🔍",
        title: "Transparent Progress",
        desc: "Traceable production via paperless workshops, digital dashboards and ERP data systems.",
    },
    {
        icon: "🎯",
        title: "Sample Consistency",
        desc: "Samples match bulk production — every step inspected from raw material to final delivery.",
    },
];
---

<BaseLayout
    lang="en"
    title="Products"
    description="Tongsheng Watch products: solid bands, edge-wrapped bands, watch cases, mesh bands and spring bands — one-stop customization solutions."
>
    <section class="page-banner">
        <h1>Products & Services</h1>
        <p>Five Categories · One-Stop Customization</p>
    </section>

    <!-- ====== Overview ====== -->
    <section class="section" id="intro">
        <div class="container">
            <h2 class="section-title">Product Overview</h2>
            <div class="about-grid">
                <div class="about-text">
                    <p>
                        With over 20 years of expertise in mid-to-high-end watch
                        accessories, Tongsheng Watch offers five major
                        categories — solid bands, edge-wrapped bands, watch
                        cases, mesh bands and spring bands. Materials range from
                        316L/304 stainless steel and 6063 aerospace aluminum to
                        titanium Grade 2/5 and tantalum, precisely matching
                        diverse brand positioning and usage scenarios.
                    </p>
                    <p>
                        With a comprehensive style library and extensive
                        Swiss-component export experience, we serve as a
                        long-term supplier to global watch brands including
                        VICTORINOX, VERSACE, TISSOT, FERRAGAMO, CITIZEN and
                        FOSSIL — 23 international brands in total.
                    </p>
                    <p>
                        We provide one-stop customization from design to
                        delivery, developing 100+ new designs annually to
                        empower global watch brand innovation.
                    </p>
                </div>
                <div class="about-image">
                    <img
                        src="https://tongshengwatch.zzydhj.com/about/KnpfAnPG.webp"
                        alt="Product Overview"
                        class="about-img"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- ====== Five Products ====== -->
    {
        collectionProducts.map((p, i) => {
            const info = productInfo[p.id] || {
                title: p.data.title,
                feature: p.data.feature,
                desc: p.data.desc,
                materials: p.data.materials,
                capacity: p.data.capacity,
            };
            return (
                <section
                    class={`section${i % 2 === 1 ? " bg-gray" : ""}`}
                    id={p.id}
                >
                    <div class="container">
                        <div class="product-block">
                            <div class="product-info">
                                <span class="product-feature">
                                    {info.feature}
                                </span>
                                <h2 class="product-title">{info.title}</h2>
                                <p class="product-desc">{info.desc}</p>
                                <div class="product-meta">
                                    <div class="meta-item">
                                        <span class="meta-label">Material</span>
                                        <span class="meta-value">
                                            {info.materials}
                                        </span>
                                    </div>
                                    <div class="meta-item">
                                        <span class="meta-label">Capacity</span>
                                        <span class="meta-value">
                                            {info.capacity}
                                        </span>
                                    </div>
                                </div>
                                <a
                                    class="product-more"
                                    href={`/products/${p.id}/`}
                                >
                                    View Details →
                                </a>
                            </div>
                            <div class="product-image">
                                <img
                                    src={p.data.image}
                                    alt={info.title}
                                    class="product-img"
                                />
                            </div>
                        </div>
                    </div>
                </section>
            );
        })
    }

    <!-- ====== Our Promise ====== -->
    <section class="section bg-gray" id="promise">
        <div class="container">
            <h2 class="section-title">Our Promise</h2>
            <p class="section-subtitle">
                Addressing industry pain points so you can cooperate with
                confidence.
            </p>
            <div class="cards-grid cols-4">
                {
                    promises.map((item) => (
                        <div class="card">
                            <div class="card-icon">{item.icon}</div>
                            <h3 class="card-title">{item.title}</h3>
                            <p class="card-desc">{item.desc}</p>
                        </div>
                    ))
                }
            </div>
            <div class="center-btn">
                <a href="/contact/" class="btn btn-primary">Request a Quote</a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .page-banner {
        background: linear-gradient(135deg, #1a1d23, #3a4250);
        color: #fff;
        text-align: center;
        padding: 80px 24px 64px;
    }
    .page-banner h1 {
        font-size: 34px;
        letter-spacing: 3px;
        margin-bottom: 14px;
    }
    .page-banner p {
        font-size: 15px;
        color: rgba(255, 255, 255, 0.75);
        letter-spacing: 2px;
    }

    .about-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 40px;
        align-items: center;
    }
    @media (min-width: 768px) {
        .about-grid {
            grid-template-columns: 1.2fr 1fr;
        }
    }
    .about-text p {
        font-size: 15px;
        line-height: 2;
        color: var(--color-text-light);
        margin-bottom: 16px;
        text-indent: 2em;
    }
    .about-img,
    .product-img {
        width: 100%;
        height: auto;
        border-radius: 8px;
        object-fit: cover;
    }

    .product-image {
        overflow: hidden;
        border-radius: 8px;
    }
    .product-img {
        transition: transform 0.35s;
    }
    .product-block:hover .product-img {
        transform: scale(1.04);
    }

    .product-block {
        position: relative;
        display: grid;
        grid-template-columns: 1fr;
        gap: 40px;
        align-items: center;
    }
    @media (min-width: 768px) {
        .product-block {
            grid-template-columns: 1.2fr 1fr;
        }
    }
    .product-feature {
        display: inline-block;
        background: var(--color-accent);
        color: #fff;
        font-size: 13px;
        padding: 5px 16px;
        border-radius: 999px;
        letter-spacing: 1px;
        margin-bottom: 16px;
    }
    .product-title {
        font-size: 30px;
        color: var(--color-primary);
        letter-spacing: 2px;
        margin-bottom: 18px;
    }
    .product-desc {
        font-size: 15px;
        line-height: 2;
        color: var(--color-text-light);
        margin-bottom: 24px;
    }
    .product-meta {
        display: flex;
        flex-direction: column;
        gap: 14px;
        border-top: 1px solid var(--color-border);
        padding-top: 20px;
    }
    .meta-item {
        display: flex;
        gap: 16px;
        font-size: 14px;
    }
    .meta-label {
        flex-shrink: 0;
        width: 60px;
        color: var(--color-accent);
        font-weight: 600;
    }
    .meta-value {
        color: var(--color-text-light);
        line-height: 1.7;
    }
    .product-more {
        display: inline-block;
        margin-top: 20px;
        font-size: 14px;
        font-weight: 600;
        color: var(--color-accent);
        text-decoration: none;
    }
    .product-more::after {
        content: "";
        position: absolute;
        inset: 0;
    }
    .product-more:hover {
        text-decoration: underline;
    }

    .cards-grid.cols-4 {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
    }
    @media (min-width: 768px) {
        .cards-grid.cols-4 {
            grid-template-columns: repeat(4, 1fr);
        }
    }
    .card {
        background: #fff;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 32px 24px;
        text-align: center;
        transition:
            box-shadow 0.25s,
            transform 0.25s;
    }
    .card:hover {
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        transform: translateY(-4px);
    }
    .card-icon {
        font-size: 32px;
        margin-bottom: 14px;
    }
    .card-title {
        font-size: 17px;
        color: var(--color-primary);
        margin-bottom: 10px;
    }
    .card-desc {
        font-size: 13px;
        color: var(--color-text-light);
        line-height: 1.8;
    }
    .center-btn {
        text-align: center;
        margin-top: 44px;
    }
</style>
