---
// news.astro - 新闻中心页（中文版）
// 新闻数据来自 src/content/news/ 内容集合（.mdx 文件），新增新闻只需加 .mdx 文件
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// 新闻数据来自 src/content/news/ 目录下的 .mdx 文件（内容集合），按日期倒序排列
// 新增新闻：在 src/content/news/ 里新建一个 .mdx 文件即可，列表页与详情页自动生成
const newsList = (await getCollection("news")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
---

<BaseLayout lang="zh" title="新闻中心" description="同盛钟表新闻动态、行业资讯与展会信息。">
  <!-- 页面横幅 -->
  <section class="page-banner">
    <h1>新闻中心</h1>
    <p>了解同盛钟表的最新动态与行业资讯</p>
  </section>

  <!-- ====== 新闻列表 ====== -->
  <section class="section">
    <div class="container">
      <div class="news-list">
        {
          newsList.map((entry) => (
            <article class="news-item">
              <div class="news-date">
                <span class="news-day">{entry.data.date.slice(8)}</span>
                <span class="news-ym">{entry.data.date.slice(0, 7)}</span>
              </div>
              <div class="news-body">
                <div class="news-meta">
                  <span class="news-category">{entry.data.category}</span>
                  <time>{entry.data.date}</time>
                </div>
                <h2 class="news-title">
                  <a href={`/news/${entry.id}/`}>{entry.data.title}</a>
                </h2>
                <p class="news-summary">{entry.data.summary}</p>
                <span class="news-more">阅读全文 →</span>
              </div>
            </article>
          ))
        }
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  /* ===== 新闻中心页专属样式 ===== */

  /* 页面横幅 */
  .page-banner {
    background: linear-gradient(135deg, #1a1d23, #3a4250);
    color: #fff;
    text-align: center;
    padding: 80px 24px 64px;
  }
  .page-banner h1 {
    font-size: 34px;
    letter-spacing: 4px;
    margin-bottom: 14px;
  }
  .page-banner p {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 2px;
  }

  /* 新闻列表 */
  .news-list {
    max-width: 860px;
    margin: 0 auto;
  }
  .news-item {
    position: relative; /* 拉伸链接锚点：让整个卡片可点击 */
    display: flex;
    gap: 28px;
    padding: 32px 0;
    border-bottom: 1px solid var(--color-border);
    transition: background 0.2s;
  }
  .news-item:hover {
    background: var(--color-bg-gray);
  }
  .news-item:first-child {
    padding-top: 8px;
  }

  /* 日期块 */
  .news-date {
    flex-shrink: 0;
    width: 76px;
    text-align: center;
    background: var(--color-bg-gray);
    border-radius: 8px;
    padding: 14px 0;
    align-self: flex-start;
  }
  .news-day {
    display: block;
    font-size: 28px;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1.1;
  }
  .news-ym {
    display: block;
    font-size: 12px;
    color: var(--color-text-light);
    margin-top: 4px;
  }

  /* 内容块 */
  .news-body {
    flex: 1;
    min-width: 0;
  }
  .news-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  .news-category {
    font-size: 12px;
    color: var(--color-accent);
    background: rgba(45, 112, 247, 0.1);
    padding: 3px 12px;
    border-radius: 999px;
  }
  .news-meta time {
    font-size: 13px;
    color: #999;
  }
  .news-title {
    font-size: 19px;
    color: var(--color-primary);
    margin-bottom: 10px;
    line-height: 1.5;
    transition: color 0.2s;
  }
  .news-item:hover .news-title {
    color: var(--color-accent);
  }
  .news-title a {
    color: inherit;
    text-decoration: none;
  }
  /* 拉伸链接：把标题链接的点击区域扩大到整个 news-item */
  .news-title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .news-more {
    display: inline-block;
    margin-top: 10px;
    font-size: 13px;
    color: var(--color-accent);
  }
  .news-summary {
    font-size: 14px;
    color: var(--color-text-light);
    line-height: 1.8;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 移动端：日期块缩小 */
  @media (max-width: 600px) {
    .news-item {
      flex-direction: column;
      gap: 14px;
    }
    .news-date {
      display: flex;
      align-items: baseline;
      gap: 8px;
      width: auto;
      padding: 8px 14px;
    }
    .news-day {
      font-size: 20px;
    }
  }

</style>
