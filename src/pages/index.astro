---
// index.astro - Homepage (English)
import BaseLayout from "../layouts/BaseLayout.astro";

const stats = [
    { value: "20+", label: "Years of Excellence" },
    { value: "280+", label: "Employees" },
    { value: "300+", label: "Production Equipment" },
    { value: "80K+", label: "Solid Bands / Month" },
    { value: "100K+", label: "Edge Bands / Month" },
    { value: "40K+", label: "Watch Cases / Month" },
];

const products = [
    {
        img: "https://tongshengwatch.zzydhj.com/products/solid-bracelet.jpg",
        title: "Solid Band",
        desc: "Molybdenum-enriched alloy resists sweat, seawater and cosmetics — ideal for sports, outdoor and coastal use.",
        href: "/products/#solid",
    },
    {
        img: "https://tongshengwatch.zzydhj.com/products/bezel-ring.jpg",
        title: "Edge-Wrapped Band",
        desc: "Premium finish with brushed, mirror, sandblasted and PVD plating options (gold, gunmetal, two-tone, rose gold).",
        href: "/products/#edge",
    },
    {
        img: "https://tongshengwatch.zzydhj.com/products/watch-case.jpg",
        title: "Watch Case",
        desc: "Supports 6063 aluminum, ceramic, 304/316L stainless steel, Ti Grade 2/5, tantalum — from bulk to bespoke.",
        href: "/products/#case",
    },
    {
        img: "https://tongshengwatch.zzydhj.com/products/mesh-bracelet.jpg",
        title: "Mesh Band",
        desc: "Fast response within 24 hours for quotes and proposals; PMC tracks every stage of production.",
        href: "/products/#mesh",
    },
    {
        img: "https://tongshengwatch.zzydhj.com/products/oyster-bracelet.jpg",
        title: "Spring Band",
        desc: "End-to-end customization from concept to delivery; extensive design library for quick turnaround.",
        href: "/products/#spring",
    },
];
---

<BaseLayout lang="en">
    <!-- ====== Hero ====== -->
    <section class="hero">
        <div class="hero-content">
            <h1 class="hero-title">
                Two Decades of Precision Craft<br />Trusted by Global Watch
                Brands
            </h1>
            <p class="hero-slogan">Quality · Efficiency · Integrity</p>
            <a href="/about/" class="btn btn-primary">Discover More</a>
        </div>
    </section>

    <!-- ====== Stats ====== -->
    <section class="section">
        <div class="container">
            <h2 class="section-title">Our Strength</h2>
            <div class="stats-grid">
                {
                    stats.map((item) => (
                        <div class="stat-item">
                            <div class="stat-value">{item.value}</div>
                            <div class="stat-label">{item.label}</div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ====== Company Intro ====== -->
    <section class="section bg-gray">
        <div class="container">
            <div class="intro-block">
                <div class="intro-text">
                    <h2 class="block-title">About Us</h2>
                    <p class="block-desc">
                        Founded in 2004, Dongguan Tongsheng Watch Co., Ltd. has
                        been dedicated to mid-to-high-end watch accessories for
                        over 20 years. Upholding the principles of quality,
                        efficiency and integrity, we craft premium watch bands
                        for global luxury brands, backed by a comprehensive
                        style library and extensive Swiss-component export
                        experience.
                    </p>
                    <p class="block-desc">
                        Our sister company, Dongguan Chuangsheng Watch Co.,
                        Ltd., integrates R&D, production and processing of
                        stainless steel edge-wrapped bands, mesh bands and watch
                        cases — delivering a one-stop service from design to
                        finished shipment.
                    </p>
                    <a href="/about/" class="btn btn-outline">Learn More</a>
                </div>
                <div class="intro-image">
                    <img
                        src="https://tongshengwatch.zzydhj.com/products/fgsmndfg.webp"
                        alt="Company Overview"
                        class="intro-img"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- ====== Products & Services ====== -->
    <section class="section">
        <div class="container">
            <h2 class="section-title">Products & Services</h2>
            <p class="section-subtitle">
                Five major categories — solid bands, edge-wrapped bands, watch
                cases, mesh bands and spring bands — crafted from 316L/304
                stainless steel, 6063 aerospace aluminum, titanium and tantalum,
                fully customizable to your brand's needs.
            </p>
            <div class="cards-grid">
                {
                    products.map((p) => (
                        <a href={p.href} class="card">
                            <img src={p.img} alt={p.title} class="card-img" />
                            <h3 class="card-title">{p.title}</h3>
                            <p class="card-desc">{p.desc}</p>
                        </a>
                    ))
                }
            </div>
            <div class="center-btn">
                <a href="/products/" class="btn btn-primary">View Products</a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    /* ===== Homepage Styles ===== */

    /* Hero */
    .hero {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 520px;
        background-image:
            linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)),
            url("https://tongshengwatch.zzydhj.com/banner.jpg");
        background-size: cover;
        background-position: center;
        text-align: center;
        padding: 80px 24px;
    }
    .hero-title {
        font-size: 36px;
        color: #fff;
        letter-spacing: 2px;
        line-height: 1.6;
        margin-bottom: 16px;
    }
    .hero-slogan {
        font-size: 18px;
        color: rgba(255, 255, 255, 0.85);
        letter-spacing: 6px;
        margin-bottom: 36px;
    }
    @media (max-width: 767px) {
        .hero {
            min-height: 380px;
        }
        .hero-title {
            font-size: 24px;
        }
    }

    /* Stats */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 24px;
        margin-top: 40px;
    }
    .stat-item {
        text-align: center;
        padding: 24px 12px;
    }
    .stat-value {
        font-size: 32px;
        font-weight: 700;
        color: var(--color-accent);
        margin-bottom: 8px;
    }
    .stat-label {
        font-size: 14px;
        color: var(--color-text-light);
    }

    /* Intro */
    .intro-block {
        display: grid;
        grid-template-columns: 1fr;
        gap: 40px;
        align-items: center;
    }
    @media (min-width: 768px) {
        .intro-block {
            grid-template-columns: 1fr 1fr;
        }
    }
    .block-title {
        font-size: 28px;
        color: var(--color-primary);
        margin-bottom: 20px;
        letter-spacing: 2px;
    }
    .block-desc {
        font-size: 15px;
        line-height: 2;
        color: var(--color-text-light);
        margin-bottom: 20px;
    }
    .intro-img {
        width: 100%;
        height: auto;
        border-radius: 8px;
        object-fit: cover;
    }

    /* Cards */
    .cards-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 24px;
    }
    @media (min-width: 768px) {
        .cards-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    .card {
        display: block;
        background: #fff;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 36px 28px;
        text-align: center;
        text-decoration: none;
        transition:
            box-shadow 0.25s,
            transform 0.25s;
    }
    .card:hover {
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        transform: translateY(-4px);
    }
    .card-img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border-radius: 6px;
        margin-bottom: 16px;
    }
    .card-title {
        font-size: 18px;
        color: var(--color-primary);
        margin-bottom: 12px;
    }
    .card-desc {
        font-size: 14px;
        color: var(--color-text-light);
        line-height: 1.8;
    }
    .center-btn {
        text-align: center;
        margin-top: 40px;
    }
</style>
