---
// about.astro - Company Introduction (English)
import BaseLayout from "../layouts/BaseLayout.astro";

const timeline = [
    {
        year: "2004",
        text: "The predecessor — Lichang Hardware Factory — was founded in Shipai, Dongguan, specializing in stainless steel watch band blank pressing, covering tooling, shearing, stamping, nitriding and polishing.",
    },
    {
        year: "2008",
        text: "Shijie Tongsheng Hardware Factory was established, adding drilling and grinding to extend the product line.",
    },
    {
        year: "2010",
        text: "Edge-wrapped band product line was launched, diversifying the portfolio and opening new markets.",
    },
    {
        year: "2013",
        text: "Relocated to Dongcheng Yuwu Industrial Zone and renamed Tongsheng Watch Co., Ltd.; solid & edge band monthly output exceeded 127,000 pieces.",
    },
    {
        year: "2014",
        text: "Added automatic polishing department; passed ISO 9001:2008 quality management certification.",
    },
    {
        year: "2016",
        text: "Added precision polishing department; introduced automatic polishing machines; launched ERP system for data-driven production; implemented paperless workshop with digital dashboards.",
    },
    {
        year: "2019",
        text: "Added large-tonnage hydraulic press; multi-cavity mold upgrade initiated.",
    },
    {
        year: "2020",
        text: "During the pandemic, operations were split: Tongsheng Watch handled solid bands, Chuangsheng Watch handled edge-wrapped bands; Chuangsheng's band blank department was established in November.",
    },
    {
        year: "2022",
        text: "Dongguan Chuangsheng Watch Co., Ltd. was officially registered; edge band monthly output exceeded 100,000 pieces; added laser cutting and CNC departments.",
    },
    {
        year: "2024",
        text: "Upgraded to new factory in Dongcheng Xiakou; Watch Case Division was established in May with CNC machining, NC cutting, optical milling and polishing teams; edge band output exceeded 110,000 pieces/month.",
    },
    {
        year: "2026",
        text: "Watch cases reached 40,000 sets/month, solid bands 80,000 pieces/month, edge bands 110,000 pieces/month; added 6 five-axis CNC machines and 24 automatic drilling machines.",
    },
];

const certificates = [
    "ISO 9001 Quality Management System Certification",
    "ISO 9001:2008 Quality System (passed in 2014)",
    "ERP System Fully Launched (2016)",
    "Swiss Component Export Experience",
    "Full-Process Quality Inspection Equipment",
    "100+ New Designs Developed Annually",
];

const LOGO_BASE = "https://tongshengwatch.zzydhj.com/customer-logo";
const clients = [
    { name: "VICTORINOX", logo: "VICTORINOX.png" },
    { name: "VERSACE", logo: "VERSACE.png" },
    { name: "TISSOT", logo: "TISSOT.png" },
    { name: "PHILIPP PLEIN", logo: "PHILIPP_PLEIN.png" },
    { name: "FERRAGAMO", logo: "FERRAGAMO.png" },
    { name: "TITAN", logo: "TITAN.png" },
    { name: "FESTINA", logo: "FESTINA.png" },
    { name: "TIMEX", logo: "TIMEX.png" },
    { name: "BOSS", logo: "BOSS.png" },
    { name: "MICHELE", logo: "MICHELE.png" },
    { name: "BULOVA / CRAVELLE", logo: "BULOVA.png" },
    { name: "FOSSIL", logo: "FOSSIL.png" },
    { name: "CITIZEN", logo: "CITIZEN.png" },
    { name: "GUESS", logo: "GUESS.png" },
    { name: "COACH", logo: "COACH.png" },
    { name: "TOUS", logo: "TOUS.png" },
    { name: "MICHAEL KORS", logo: "MICHAEL_KORS.png" },
    { name: "LOLA ROSE", logo: "LOLA_ROSE.png" },
    { name: "DKNY", logo: "DKNY.png" },
    { name: "Kenneth Cole", logo: "KENNETH_COLE.png" },
    { name: "TOMMY HILFIGER", logo: "TOMMY_HILFIGER.png" },
    { name: "LACOSTE", logo: "LACOSTE.png" },
    { name: "DIESEL", logo: "DIESEL.png" },
];
---

<BaseLayout
    lang="en"
    title="Company"
    description="Learn about Dongguan Tongsheng Watch Co., Ltd. — our history, philosophy, quality commitment, certifications and global clients."
>
    <section class="page-banner">
        <h1>Company</h1>
        <p>Two decades of dedication to premium watch accessories</p>
    </section>

    <!-- ====== Introduction ====== -->
    <section class="section" id="intro">
        <div class="container">
            <h2 class="section-title">Introduction</h2>
            <div class="about-grid">
                <div class="about-text">
                    <p>
                        Founded in April 2004, Dongguan Tongsheng Watch Co.,
                        Ltd. has been dedicated to mid-to-high-end watch
                        accessories for over 20 years. Upholding the principles
                        of quality, efficiency and integrity, we craft premium
                        watch bands for global luxury brands. With a
                        comprehensive style library and extensive
                        Swiss-component export experience, our products meet
                        international high-end market standards.
                    </p>
                    <p>
                        Our solid watch bands are crafted from top-grade
                        materials including 316L stainless steel, 304 stainless
                        steel, 6063 aerospace aluminum, titanium Grade 2,
                        titanium Grade 5 and tantalum (an ultra-hard specialty
                        material), precisely matching diverse brand positioning
                        and usage scenarios.
                    </p>
                    <p>
                        With a 5,000 m² modern production facility and over 200
                        advanced machines — including presses, hydraulic
                        presses, CNC machines, wire-cutting machines, laser
                        cutters, EDM machines, automatic drilling machines and
                        polishing machines — our solid stainless steel band
                        capacity reaches 80,000 pieces per month. We employ 190
                        staff, including 50 skilled technicians across stamping,
                        drilling, milling, assembly, polishing and CNC
                        operations.
                    </p>
                    <p>
                        Our sister company, Dongguan Chuangsheng Watch Co., Ltd.
                        (est. 2008, officially registered 2022), integrates R&D,
                        production and processing of stainless steel
                        edge-wrapped bands, mesh bands and watch cases. Current
                        monthly output: edge bands 100,000 pcs, mesh bands
                        30,000 pcs, watch cases 40,000 sets — offering one-stop
                        service from design to delivery with 100+ new designs
                        developed annually.
                    </p>
                </div>
                <div class="about-image">
                    <img
                        src="https://tongshengwatch.zzydhj.com/products/fgsmndfg.webp"
                        alt="Company Facility"
                        class="about-img"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- ====== Philosophy ====== -->
    <section class="section bg-gray" id="philosophy">
        <div class="container">
            <h2 class="section-title">Philosophy</h2>
            <p class="section-subtitle">Quality · Efficiency · Integrity</p>
            <div class="cards-grid cols-4">
                <div class="card">
                    <div class="card-icon">🎯</div>
                    <h3 class="card-title">Business Philosophy</h3>
                    <p class="card-desc">
                        Quality, efficiency and integrity — crafting premium
                        watch bands for global luxury brands.
                    </p>
                </div>
                <div class="card">
                    <div class="card-icon">💎</div>
                    <h3 class="card-title">Quality Policy</h3>
                    <p class="card-desc">
                        Standardized management, quality first, customer focus,
                        continuous improvement.
                    </p>
                </div>
                <div class="card">
                    <div class="card-icon">🏭</div>
                    <h3 class="card-title">Management</h3>
                    <p class="card-desc">
                        6S management since 2006, with comprehensive training,
                        assessment and incentive systems.
                    </p>
                </div>
                <div class="card">
                    <div class="card-icon">🤝</div>
                    <h3 class="card-title">Spirit</h3>
                    <p class="card-desc">
                        Continuous learning and technical innovation, growing
                        together with our partners.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ====== History ====== -->
    <section class="section" id="history">
        <div class="container">
            <h2 class="section-title">History</h2>
            <div class="timeline">
                {
                    timeline.map((item) => (
                        <div class="timeline-item">
                            <div class="timeline-year">{item.year}</div>
                            <div class="timeline-dot" />
                            <div class="timeline-text">{item.text}</div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ====== Quality ====== -->
    <section class="section bg-gray" id="quality">
        <div class="container">
            <h2 class="section-title">Quality Assurance</h2>
            <p class="section-subtitle">
                Adhering to standardized management, quality first, customer
                focus and continuous improvement, with full-process inspection
                from raw materials to finished products.
            </p>
            <div class="cards-grid cols-4">
                <div class="card">
                    <div class="card-num">01</div>
                    <h3 class="card-title">Material Selection</h3>
                    <p class="card-desc">
                        Premium 316L/304 stainless steel, 6063 aluminum, Ti
                        Grade 2/5 and tantalum — quality starts at the source.
                    </p>
                </div>
                <div class="card">
                    <div class="card-num">02</div>
                    <h3 class="card-title">Precision Machining</h3>
                    <p class="card-desc">
                        300+ machines including CNC, NC lathes, laser cutters
                        and automatic drills — micron-level accuracy.
                    </p>
                </div>
                <div class="card">
                    <div class="card-num">03</div>
                    <h3 class="card-title">Testing & Inspection</h3>
                    <p class="card-desc">
                        Water-pressure testers, swing testers, artificial sweat
                        testers, salt-spray testers and more.
                    </p>
                </div>
                <div class="card">
                    <div class="card-num">04</div>
                    <h3 class="card-title">Certified Systems</h3>
                    <p class="card-desc">
                        ISO 9001:2008 certified (2014); ERP system for
                        data-driven operations (2016).
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ====== Certificates ====== -->
    <section class="section" id="certificates">
        <div class="container">
            <h2 class="section-title">Certifications</h2>
            <div class="cert-grid">
                {
                    certificates.map((cert) => (
                        <div class="cert-item">
                            <div class="cert-icon">📜</div>
                            <span>{cert}</span>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ====== Clients ====== -->
    <section class="section bg-gray" id="clients">
        <div class="container">
            <h2 class="section-title">Our Clients</h2>
            <p class="section-subtitle">
                As a long-term supplier to global mid-to-high-end watch brands,
                Tongsheng & Chuangsheng serve the following internationally
                renowned brands.
            </p>
            <div class="cert-grid client-grid">
                {
                    clients.map((client) => (
                        <div class="cert-item client-item">
                            <img
                                class="client-logo"
                                src={`${LOGO_BASE}/${client.logo}`}
                                alt={client.name}
                                loading="lazy"
                            />
                            <span class="client-name">{client.name}</span>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    /* ===== Company Page Styles ===== */

    .page-banner {
        background: linear-gradient(135deg, #1a1d23, #3a4250);
        color: #fff;
        text-align: center;
        padding: 80px 24px 64px;
    }
    .page-banner h1 {
        font-size: 34px;
        letter-spacing: 3px;
        margin-bottom: 14px;
    }
    .page-banner p {
        font-size: 15px;
        color: rgba(255, 255, 255, 0.75);
        letter-spacing: 2px;
    }

    .about-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 40px;
        align-items: center;
    }
    @media (min-width: 768px) {
        .about-grid {
            grid-template-columns: 1.2fr 1fr;
        }
    }
    .about-text p {
        font-size: 15px;
        line-height: 2;
        color: var(--color-text-light);
        margin-bottom: 16px;
        text-indent: 2em;
    }
    .about-img {
        width: 100%;
        height: auto;
        border-radius: 8px;
        object-fit: cover;
    }

    .cards-grid.cols-4 {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
    }
    @media (min-width: 768px) {
        .cards-grid.cols-4 {
            grid-template-columns: repeat(4, 1fr);
        }
    }
    .card {
        background: #fff;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 32px 24px;
        text-align: center;
        transition:
            box-shadow 0.25s,
            transform 0.25s;
    }
    .card:hover {
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        transform: translateY(-4px);
    }
    .card-icon {
        font-size: 32px;
        margin-bottom: 14px;
    }
    .card-num {
        font-size: 26px;
        font-weight: 700;
        color: var(--color-accent);
        margin-bottom: 12px;
    }
    .card-title {
        font-size: 17px;
        color: var(--color-primary);
        margin-bottom: 10px;
    }
    .card-desc {
        font-size: 13px;
        color: var(--color-text-light);
        line-height: 1.8;
    }

    .timeline {
        max-width: 760px;
        margin: 48px auto 0;
        position: relative;
        padding-left: 32px;
    }
    .timeline::before {
        content: "";
        position: absolute;
        left: 8px;
        top: 6px;
        bottom: 6px;
        width: 2px;
        background: var(--color-border);
    }
    .timeline-item {
        position: relative;
        padding: 0 0 36px 24px;
    }
    .timeline-item:last-child {
        padding-bottom: 0;
    }
    .timeline-dot {
        position: absolute;
        left: -30px;
        top: 5px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--color-accent);
        border: 3px solid #fff;
        box-shadow: 0 0 0 2px var(--color-accent);
    }
    .timeline-year {
        font-size: 20px;
        font-weight: 700;
        color: var(--color-accent);
        margin-bottom: 6px;
    }
    .timeline-text {
        font-size: 14px;
        color: var(--color-text-light);
        line-height: 1.9;
    }

    .cert-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
        margin-top: 40px;
    }
    @media (min-width: 600px) {
        .cert-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (min-width: 900px) {
        .cert-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    .cert-item {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #fff;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 20px 22px;
        font-size: 14px;
        color: var(--color-text);
        transition: box-shadow 0.2s;
    }
    .cert-item:hover {
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
    }
    .cert-icon {
        font-size: 24px;
        flex-shrink: 0;
    }

    .client-item {
        flex-direction: column;
        justify-content: center;
        text-align: center;
        padding: 8px 8px;
    }
    .client-logo {
        height: 110px;
        max-width: 100%;
        width: auto;
        object-fit: contain;
    }
    .client-name {
        margin-bottom: 6px;
        font-size: 13px;
        color: var(--color-text-light);
    }
    @media (min-width: 1200px) {
        .client-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }
</style>
