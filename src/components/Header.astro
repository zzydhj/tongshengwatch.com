---
// Header.astro - 顶部导航组件（桌面端下拉菜单 + 移动端侧滑菜单 + 语言切换）
import { siteConfig, navItems, localizeHref, type Lang } from "../config";

interface Props {
  lang?: Lang;
}
const lang: Lang = Astro.props.lang ?? "zh";
const site = siteConfig[lang];

// 当前页面路径，用于高亮导航项
const currentPath = Astro.url.pathname;

// 判断导航项是否处于激活状态（对比中文路径，去掉 /en 前缀和锚点）
function isActive(href: string): boolean {
  const path = href.split("#")[0]; // 配置里的中文路径，如 /about/
  const cur = currentPath.replace(/^\/en/, "") || "/"; // 当前路径去掉 /en 前缀
  if (path === "/") return cur === "/";
  return cur.startsWith(path);
}

// 语言切换：跳到另一语言版本的对应页面
const otherLangHref =
  lang === "zh"
    ? `/en${currentPath}`
    : currentPath.replace(/^\/en/, "") || "/";
const switchLabel = lang === "zh" ? "EN" : "中文";
---

<header class="site-header">
  <div class="header-inner">
    <!-- Logo -->
    <a href={localizeHref("/", lang)} class="logo">
      <img src={siteConfig.logo} alt={site.name} class="logo-img" />
      <span class="logo-text">{site.name}</span>
    </a>

    <!-- 桌面端导航 -->
    <nav class="desktop-nav" aria-label="主导航">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li class={`nav-item${item.children ? " has-dropdown" : ""}`}>
              <a
                href={localizeHref(item.href, lang)}
                class={`nav-link${isActive(item.href) ? " active" : ""}`}
              >
                {item[lang]}
                {item.children && (
                  <svg
                    class="arrow-icon"
                    viewBox="0 0 24 24"
                    width="12"
                    height="12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                )}
              </a>
              {item.children && (
                <ul class="dropdown">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={localizeHref(child.href, lang)}
                        class="dropdown-link"
                      >
                        {child[lang]}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
        <!-- 语言切换按钮 -->
        <li class="nav-item nav-lang">
          <a href={otherLangHref} class="lang-switch">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="10" />
              <path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z" />
            </svg>
            {switchLabel}
          </a>
        </li>
      </ul>
    </nav>

    <!-- 移动端：语言切换 + 汉堡按钮 -->
    <div class="mobile-actions-right">
      <a href={otherLangHref} class="lang-switch lang-switch-mobile">{switchLabel}</a>
      <button class="menu-toggle" id="menuToggle" aria-label="打开菜单">
        <span class="hamburger-line" />
        <span class="hamburger-line" />
        <span class="hamburger-line" />
      </button>
    </div>
  </div>
</header>

<!-- 移动端遮罩 -->
<div class="mobile-overlay" id="mobileOverlay" />

<!-- 移动端侧滑菜单 -->
<nav class="mobile-menu" id="mobileMenu" aria-label="移动端导航">
  <div class="mobile-menu-header">
    <span class="mobile-menu-title">{site.name}</span>
    <button class="menu-close" id="menuClose" aria-label="关闭菜单">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12" />
      </svg>
    </button>
  </div>
  <ul class="mobile-nav-list">
    {
      navItems.map((item) => (
        <li class="mobile-nav-item">
          {item.children ? (
            <>
              <details class="mobile-dropdown">
                <summary class="mobile-nav-link">
                  {item[lang]}
                  <svg
                    class="mobile-arrow"
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </summary>
                <ul class="mobile-sub-list">
                  <li>
                    <a href={localizeHref(item.href, lang)} class="mobile-sub-link">
                      {item[lang]}{lang === "zh" ? "（总览）" : ""}
                    </a>
                  </li>
                  {item.children.map((child) => (
                    <li>
                      <a href={localizeHref(child.href, lang)} class="mobile-sub-link">
                        {child[lang]}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </>
          ) : (
            <a
              href={localizeHref(item.href, lang)}
              class={`mobile-nav-link${isActive(item.href) ? " active" : ""}`}
            >
              {item[lang]}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const toggle = document.getElementById("menuToggle");
  const close = document.getElementById("menuClose");
  const menu = document.getElementById("mobileMenu");
  const overlay = document.getElementById("mobileOverlay");

  function openMenu() {
    menu?.classList.add("open");
    overlay?.classList.add("open");
    document.body.style.overflow = "hidden";
  }
  function closeMenu() {
    menu?.classList.remove("open");
    overlay?.classList.remove("open");
    document.body.style.overflow = "";
  }

  toggle?.addEventListener("click", openMenu);
  close?.addEventListener("click", closeMenu);
  overlay?.addEventListener("click", closeMenu);

  // 点击菜单内链接后自动关闭
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>

<style>
  /* ========== 顶部固定 Header ========== */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 70px;
    background: #fff;
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.08);
    z-index: 1000;
  }
  .header-inner {
    max-width: 1200px;
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #1a1a1a;
    flex-shrink: 0;
  }
  .logo-img {
    height: 44px;
    width: auto;
    object-fit: contain;
  }
  .logo-text {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 2px;
    white-space: nowrap;
  }

  /* ========== 桌面端导航 ========== */
  .desktop-nav {
    display: none;
  }
  @media (min-width: 900px) {
    .desktop-nav {
      display: block;
    }
    .menu-toggle {
      display: none !important;
    }
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-item {
    position: relative;
  }
  .nav-link {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 10px 16px;
    font-size: 15px;
    color: #333;
    text-decoration: none;
    white-space: nowrap;
    border-radius: 4px;
    transition: color 0.2s, background 0.2s;
    cursor: pointer;
  }
  .nav-link:hover,
  .nav-link.active {
    color: #000;
    font-weight: 600;
  }
  .nav-link.active {
    border-bottom: 2px solid #000;
    border-radius: 0;
  }
  .arrow-icon {
    transition: transform 0.25s;
  }

  /* 下拉菜单 */
  .dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    min-width: 160px;
    background: #fff;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.12);
    border-radius: 6px;
    padding: 8px 0;
    list-style: none;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s, transform 0.25s, visibility 0.25s;
  }
  .nav-item.has-dropdown:hover .dropdown,
  .nav-item.has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .nav-item.has-dropdown:hover .arrow-icon {
    transform: rotate(180deg);
  }
  .dropdown-link {
    display: block;
    padding: 11px 22px;
    font-size: 14px;
    color: #2e2e2f;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .dropdown-link:hover {
    background: #f5f5f5;
    color: #000;
  }

  /* ========== 语言切换按钮 ========== */
  .mobile-actions-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 14px;
    font-size: 13px;
    color: #444;
    border: 1px solid #d9d9d9;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .lang-switch:hover {
    border-color: #000;
    color: #000;
    background: #fafafa;
  }
  .lang-switch-mobile {
    padding: 6px 12px;
  }

  /* 语言切换按钮暂时隐藏（后续配置多语言后，删除下面这段即可恢复） */
  .nav-lang,
  .lang-switch-mobile {
    display: none !important;
  }

  /* ========== 汉堡按钮 ========== */
  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 10px;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 6px;
    transition: background 0.2s;
  }
  .menu-toggle:hover {
    background: #f2f2f2;
  }
  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background: #333;
    border-radius: 2px;
    transition: transform 0.3s, opacity 0.3s;
  }

  /* ========== 移动端遮罩 & 侧滑菜单 ========== */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 1998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
  }
  .mobile-overlay.open {
    opacity: 1;
    visibility: visible;
  }
  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 280px;
    max-width: 80vw;
    background: #fff;
    z-index: 1999;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }
  .mobile-menu.open {
    transform: translateX(0);
  }
  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    border-bottom: 1px solid #eee;
    flex-shrink: 0;
  }
  .mobile-menu-title {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 1px;
  }
  .menu-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: #666;
    border-radius: 6px;
    display: flex;
    transition: background 0.2s;
  }
  .menu-close:hover {
    background: #f2f2f2;
  }
  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 10px 0;
  }
  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    font-size: 15px;
    color: #333;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s;
    list-style: none;
  }
  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    background: #f7f7f7;
    color: #000;
  }
  .mobile-dropdown summary::-webkit-details-marker {
    display: none;
  }
  .mobile-dropdown .mobile-arrow {
    transition: transform 0.25s;
  }
  .mobile-dropdown[open] .mobile-arrow {
    transform: rotate(180deg);
  }
  .mobile-sub-list {
    list-style: none;
    margin: 0;
    padding: 0;
    background: #fafafa;
  }
  .mobile-sub-link {
    display: block;
    padding: 12px 24px 12px 42px;
    font-size: 14px;
    color: #555;
    text-decoration: none;
    transition: background 0.15s;
  }
  .mobile-sub-link:hover {
    background: #f0f0f0;
    color: #000;
  }
</style>
